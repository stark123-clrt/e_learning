{% extends 'layout/_shell_etudiant.html.twig' %}
{% set active_nav = 'dashboard' %}
{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Bienvenue{% if prenom %}, {{ prenom }}{% endif %}{% endblock %}
{% block content %}

<div class="kpi-grid-3">
  <div class="card"><div class="stat-card-body"><div class="kpi-label">Formations suivies</div><div class="stat-big-value">{{ formationsSuivies }}</div></div></div>
  <div class="card"><div class="stat-card-body-primary"><div class="kpi-label">Moyenne générale</div><div class="stat-big-value-primary">{{ moyenne }}<span style="font-size:16px;font-weight:500;color:var(--color-primary-hover);">/20</span></div></div></div>
  <div class="card"><div class="stat-card-body">
    <div class="kpi-label">Prochaine formation</div>
    {% if prochaineFormation %}
      <div style="font-size:15px;font-weight:600;margin-top:8px;">{{ prochaineFormation.titre }}</div>
      <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">Débute le {{ prochaineFormation.dateDebut|date('d/m/Y') }}</div>
    {% else %}
      <div style="font-size:14px;color:var(--text-muted);margin-top:8px;">Aucune à venir</div>
    {% endif %}
  </div></div>
</div>

<div class="section-title" style="font-size:20px;margin-top:32px;">Mes formations</div>
<div class="formation-grid">
  {% for inscription in inscriptions %}
    <div class="card">
      <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
      <div class="card-body">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
          <div class="card-title" style="font-size:15px;">{{ inscription.formation ? inscription.formation.titre : '—' }}</div>
          <span class="badge {{ inscription.statut|upper == 'ACTIVE' ? 'badge-success' : 'badge-neutral' }}">{{ inscription.statut|capitalize }}</span>
        </div>
        <div style="font-size:14px;font-weight:600;margin-top:10px;color:{{ inscription.note is not null ? 'var(--success-500)' : 'var(--text-muted)' }};">
          {{ inscription.note is not null ? inscription.note ~ '/20' : 'Pas encore noté' }}
        </div>
      </div>
    </div>
  {% else %}
    <div style="font-size:14px;color:var(--text-muted);">Vous n'êtes inscrit à aucune formation. Consultez le <a href="{{ path('etudiant_catalogue') }}">catalogue</a>.</div>
  {% endfor %}
</div>

{% endblock %}
