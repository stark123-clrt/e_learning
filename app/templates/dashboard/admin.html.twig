{% extends 'layout/_shell_admin.html.twig' %}
{% set active_nav = 'dashboard' %}
{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Vue d'ensemble de la plateforme{% endblock %}
{% block content %}

<div class="kpi-grid">
  <div class="card"><div class="kpi-card-body">
    <div class="kpi-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
    <div><div class="kpi-label">Total étudiants</div><div class="kpi-value">{{ totalEtudiants }}</div></div>
  </div></div>
  <div class="card"><div class="kpi-card-body">
    <div class="kpi-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg></div>
    <div><div class="kpi-label">Total formateurs</div><div class="kpi-value">{{ totalFormateurs }}</div></div>
  </div></div>
  <div class="card"><div class="kpi-card-body">
    <div class="kpi-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div><div class="kpi-label">Total formations</div><div class="kpi-value">{{ totalFormations }}</div></div>
  </div></div>
  <div class="card"><div class="kpi-card-body">
    <div class="kpi-icon-wrap" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg></div>
    <div><div class="kpi-label">Total inscriptions</div><div class="kpi-value">{{ totalInscriptions }}</div></div>
  </div></div>
</div>

<div class="grid-3col" style="margin-top:24px;">
  <div class="card" style="grid-column:span 1;">
    <div class="card-body">
      <div class="card-title">Inscriptions par formation</div>
      <div class="bar-chart-row">
        {% for b in barChartData %}
          <div class="bar-col"><div style="font-size:12px;font-weight:600;">{{ b.count }}</div><div class="bar" style="height:{{ b.height }}%;"></div><div class="bar-label">{{ b.label }}</div></div>
        {% else %}
          <div style="font-size:13px;color:var(--text-muted);">Aucune inscription pour l'instant.</div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="card-title">Formations par catégorie</div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:14px;margin-top:12px;">
        <div class="donut" style="background:{{ donutGradient }};" role="img" aria-label="Répartition des formations par catégorie"></div>
        <div class="donut-legend">
          {% for d in donutData %}
            <div class="donut-legend-row"><span class="dot" style="background:{{ d.color }};"></span><span class="label">{{ d.label }}</span><span class="count">· {{ d.count }}</span></div>
          {% else %}
            <div style="font-size:13px;color:var(--text-muted);">Aucune formation.</div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="col-narrow">
    <div class="card"><div class="stat-card-body">
      <div class="kpi-label">Prix moyen des formations</div>
      <div class="stat-big-value">{{ avgPrice }} €</div>
    </div></div>
    <div class="card"><div class="stat-card-body-primary">
      <div class="kpi-label">Note moyenne générale</div>
      <div class="stat-big-value-primary">{{ avgNote }}<span style="font-size:16px;color:var(--color-primary-hover);font-weight:500;">/20</span></div>
    </div></div>
  </div>
</div>

<div class="grid-2col" style="margin-top:24px;">
  <div class="card">
    <div class="card-body">
      <div class="card-title">Top 5 des formations les plus inscrites</div>
      <div style="display:flex;flex-direction:column;gap:14px;margin-top:14px;">
        {% for f in topFormations %}
          <div style="display:flex;align-items:center;gap:12px;"><div class="rank-badge">{{ f.rank }}</div><div style="flex:1;min-width:0;"><div style="font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ f.label }}</div><div class="track"><div class="track-fill" style="width:{{ f.width }}%;"></div></div></div><div style="font-size:13px;font-weight:600;">{{ f.count }}</div></div>
        {% else %}
          <div style="font-size:13px;color:var(--text-muted);">Aucune donnée.</div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="card-title">Top 5 des meilleurs étudiants</div>
      <div style="display:flex;flex-direction:column;gap:12px;margin-top:14px;">
        {% for s in topStudents %}
          <div style="display:flex;align-items:center;gap:12px;"><div class="rank-badge">{{ s.rank }}</div><div class="avatar avatar-sm" aria-hidden="true">{{ s.initiales }}</div><div style="flex:1;font-size:13px;font-weight:500;">{{ s.name }}</div><div style="font-size:13px;font-weight:700;color:var(--success-500);">{{ s.moyenne }}/20</div></div>
        {% else %}
          <div style="font-size:13px;color:var(--text-muted);">Aucune note attribuée.</div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% endblock %}
