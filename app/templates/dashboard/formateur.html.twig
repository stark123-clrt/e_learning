{% extends 'layout/_shell_formateur.html.twig' %}
{% set active_nav = 'dashboard' %}
{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Vue d'ensemble de vos formations{% endblock %}
{% block content %}

<div class="kpi-grid-3">
  <div class="card"><div class="stat-card-body"><div class="kpi-label">Formations actives</div><div class="stat-big-value">{{ formationsActives }}</div></div></div>
  <div class="card"><div class="stat-card-body"><div class="kpi-label">Total étudiants</div><div class="stat-big-value">{{ totalEtudiants }}</div></div></div>
  <div class="card"><div class="stat-card-body-primary"><div class="kpi-label">Note moyenne donnée</div><div class="stat-big-value-primary">{{ noteMoyenne }}<span style="font-size:16px;font-weight:500;">/20</span></div></div></div>
</div>

<div class="section-title" style="font-size:20px;margin-top:32px;">Mes formations</div>
<div class="formation-grid">
  {% for formation in formations %}
    {% set apercu = apercus[formation.id]|default(null) %}
    {% set vignette = apercu ? youtube_thumbnail(apercu) : null %}
    <div class="card">
      {% if vignette %}
        <div class="card-media" style="padding:0;overflow:hidden;position:relative;">
          <img src="{{ vignette }}" alt="Aperçu {{ formation.titre }}" style="width:100%;height:100%;object-fit:cover;">
          <span style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;">
            <span style="width:44px;height:44px;border-radius:9999px;background:rgba(0,0,0,0.55);display:flex;align-items:center;justify-content:center;"><svg width="20" height="20" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
          </span>
        </div>
      {% else %}
        <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
      {% endif %}
      <div class="card-body">
        <div class="card-title" style="font-size:15px;">{{ formation.titre }}</div>
        <div style="font-size:13px;color:var(--text-secondary);margin-top:8px;">{{ formation.duree }} semaines · capacité {{ formation.capaciteMax }}</div>
      </div>
    </div>
  {% else %}
    <div style="font-size:14px;color:var(--text-muted);">Aucune formation ne vous est encore attribuée.</div>
  {% endfor %}
</div>

{% endblock %}
