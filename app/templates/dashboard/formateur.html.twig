{% extends 'layout/_shell_formateur.html.twig' %}
{% set active_nav = 'dashboard' %}
{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Vue d'ensemble de vos formations{% endblock %}
{% block content %}

<div class="kpi-grid-3">
  <div class="card"><div class="stat-card-body"><div class="kpi-label">Formations actives</div><div class="stat-big-value">1</div></div></div>
  <div class="card"><div class="stat-card-body"><div class="kpi-label">Total étudiants</div><div class="stat-big-value">4</div></div></div>
  <div class="card"><div class="stat-card-body-primary"><div class="kpi-label">Note moyenne donnée</div><div class="stat-big-value-primary">14,6<span style="font-size:16px;font-weight:500;">/20</span></div></div></div>
</div>

<div class="section-title" style="font-size:20px;margin-top:32px;">Prochaines formations</div>
<div class="formation-grid">
  <div class="card">
    <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div class="card-body">
      <div class="card-title" style="font-size:15px;">Développement Web Full-Stack</div>
      <div style="font-size:13px;color:var(--text-secondary);margin-top:8px;">12 semaines · 20/24 places</div>
    </div>
  </div>
</div>

{% endblock %}
