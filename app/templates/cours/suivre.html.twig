{% extends 'layout/_shell_etudiant.html.twig' %}
{% set active_nav = 'inscriptions' %}
{% block page_title %}{{ formation.titre }}{% endblock %}
{% block page_subtitle %}Suivez les cours de la formation{% endblock %}
{% block content %}

{% for message in app.flashes('success') %}
  <div style="background:var(--success-50);color:var(--success-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}

<a class="btn btn-secondary" href="{{ path('etudiant_inscriptions') }}" style="margin-bottom:16px;">← Mes inscriptions</a>

<div class="card" style="margin-bottom:24px;"><div class="card-body">
  <div style="display:flex;justify-content:space-between;align-items:center;">
    <div class="card-title">Progression</div>
    <div style="font-size:14px;font-weight:600;color:var(--color-primary-hover);">{{ progression }}%</div>
  </div>
  <div class="track" style="margin-top:10px;"><div class="track-fill" style="width:{{ progression }}%;"></div></div>
</div></div>

{% for c in cours %}
  <div class="card" style="margin-bottom:20px;"><div class="card-body">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
      <div class="card-title">{{ c.ordre }}. {{ c.titre }}</div>
      {% if termines[c.id] is defined %}<span class="badge badge-success">Terminé</span>{% endif %}
    </div>
    {% if c.description %}<div style="font-size:13px;color:var(--text-secondary);margin-top:6px;">{{ c.description }}</div>{% endif %}
    {% set embed = youtube_embed(c.videoUrl) %}
    <div style="margin-top:12px;">
      {% if embed %}
        <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:var(--radius-md);">
          <iframe src="{{ embed }}" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allowfullscreen title="{{ c.titre }}"></iframe>
        </div>
      {% else %}
        <a class="btn btn-secondary" href="{{ c.videoUrl }}" target="_blank" rel="noopener">Ouvrir la vidéo ↗</a>
      {% endif %}
    </div>
    {% if termines[c.id] is not defined %}
      <form action="{{ path('etudiant_cours_terminer', {id: c.id}) }}" method="post" style="margin-top:14px;">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('terminer_' ~ c.id) }}">
        <button class="btn btn-primary btn-sm" type="submit">Marquer comme terminé</button>
      </form>
    {% endif %}
  </div></div>
{% else %}
  <div class="card"><div class="card-body"><div style="font-size:14px;color:var(--text-muted);">Aucun cours n'est encore disponible pour cette formation.</div></div></div>
{% endfor %}

{% endblock %}
