{% extends 'base.html.twig' %}

{% block title %}{{ block('page_title') }} — e-learning{% endblock %}
{% block page_title %}Titre par défaut{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block body %}
<div class="app-shell">

  <aside class="sidebar" data-sidebar>
    <div class="brand-row">
      <div class="brand-mark" aria-hidden="true"><img src="/logo.png" alt="e-learning"></div>
      <div>
        <div class="brand-name">e-learning</div>
        <div class="brand-role">Étudiant</div>
      </div>
    </div>
    <nav class="nav-list" aria-label="Navigation principale">
      <a class="nav-item {{ active_nav == 'dashboard' ? 'active' : '' }}" href="/etudiant/dashboard"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Dashboard</span></a>
      <a class="nav-item {{ active_nav == 'catalogue' ? 'active' : '' }}" href="/etudiant/catalogue"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg><span>Catalogue</span></a>
      <a class="nav-item {{ active_nav == 'inscriptions' ? 'active' : '' }}" href="/etudiant/inscriptions"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg><span>Mes inscriptions</span></a>
      <a class="nav-item {{ active_nav == 'notes' ? 'active' : '' }}" href="/etudiant/notes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg><span>Mes notes</span></a>
      <a class="nav-item {{ active_nav == 'moyenne' ? 'active' : '' }}" href="/etudiant/moyenne"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg><span>Ma moyenne</span></a>
      <a class="nav-item {{ active_nav == 'profil' ? 'active' : '' }}" href="/etudiant/profil"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Profil</span></a>
      <a class="nav-item logout" href="/login"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg><span>Déconnexion</span></a>
    </nav>
    <div class="user-row">
      <div class="avatar avatar-md" aria-hidden="true">{{ current_user_initials() }}</div>
      <div style="min-width:0;">
        <div class="user-name">{{ current_user_name() }}</div>
        <div class="user-role">{{ current_user_role_label() }}</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-backdrop" data-sidebar-backdrop></div>

  <div class="main-col">
    <header class="topbar">
      <div class="topbar-titles">
        <button class="menu-toggle" data-menu-toggle type="button" aria-label="Ouvrir le menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div>
          <div class="page-title">{{ block('page_title') }}</div>
          <div class="page-subtitle">{{ block('page_subtitle') }}</div>
        </div>
      </div>
      <div class="topbar-right">
        <div class="avatar avatar-sm" aria-hidden="true">{{ current_user_initials() }}</div>
      </div>
    </header>

    <main class="content">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
{% endblock %}
