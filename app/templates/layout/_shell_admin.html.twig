{% extends 'base.html.twig' %}

{% block title %}{{ block('page_title') }} — e-learning{% endblock %}
{% block page_title %}Titre par défaut{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block body %}
<div class="app-shell">

  <aside class="sidebar" data-sidebar>
    <div class="brand-row">
      <div class="brand-mark" aria-hidden="true">e</div>
      <div>
        <div class="brand-name">e-learning</div>
        <div class="brand-role">Administrateur</div>
      </div>
    </div>
    <nav class="nav-list" aria-label="Navigation principale">
      <a class="nav-item {{ active_nav == 'dashboard' ? 'active' : '' }}" href="/admin/dashboard"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Dashboard</span></a>
      <a class="nav-item {{ active_nav == 'etudiants' ? 'active' : '' }}" href="/admin/etudiants"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg><span>Étudiants</span></a>
      <a class="nav-item {{ active_nav == 'formateurs' ? 'active' : '' }}" href="/admin/formateurs"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg><span>Formateurs</span></a>
      <a class="nav-item {{ active_nav == 'formations' ? 'active' : '' }}" href="/admin/formations"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg><span>Formations</span></a>
      <a class="nav-item {{ active_nav == 'classes' ? 'active' : '' }}" href="/admin/classes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg><span>Classes</span></a>
      <a class="nav-item {{ active_nav == 'inscriptions' ? 'active' : '' }}" href="/admin/inscriptions"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg><span>Inscriptions</span></a>
      <a class="nav-item {{ active_nav == 'statistiques' ? 'active' : '' }}" href="/admin/statistiques"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg><span>Statistiques</span></a>
      <a class="nav-item {{ active_nav == 'comptes' ? 'active' : '' }}" href="/admin/comptes"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Comptes</span></a>
      <a class="nav-item logout" href="/login"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg><span>Déconnexion</span></a>
    </nav>
    <div class="user-row">
      <div class="avatar avatar-md" aria-hidden="true">CL</div>
      <div style="min-width:0;">
        <div class="user-name">Camille Lefevre</div>
        <div class="user-role">Administrateur</div>
      </div>
    </div>
  </aside>
  <div class="sidebar-backdrop" data-sidebar-backdrop></div>

  <div class="main-col">
    <header class="topbar">
      <div class="topbar-titles">
        <button class="menu-toggle" data-menu-toggle type="button" aria-label="Ouvrir le menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div>
          <div class="page-title">{{ block('page_title') }}</div>
          <div class="page-subtitle">{{ block('page_subtitle') }}</div>
        </div>
      </div>
      <div class="topbar-right">
        <div class="avatar avatar-sm" aria-hidden="true">CL</div>
      </div>
    </header>

    <main class="content">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
{% endblock %}
