{% extends 'layout/_shell_admin.html.twig' %}
{% set active_nav = 'inscriptions' %}
{% block page_title %}Inscriptions{% endblock %}
{% block page_subtitle %}Toutes les inscriptions de la plateforme{% endblock %}
{% block content %}

{% for message in app.flashes('success') %}
  <div style="background:var(--success-50);color:var(--success-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Étudiant</th><th>Formation</th><th>Date</th><th>Statut</th><th>Note</th></tr></thead>
      <tbody>
        {% for inscription in inscriptions %}
          <tr>
            <td>{{ inscription.etudiant ? inscription.etudiant.prenom ~ ' ' ~ inscription.etudiant.nom : '—' }}</td>
            <td>{{ inscription.formation ? inscription.formation.titre : '—' }}</td>
            <td>{{ inscription.dateInscription|date('d/m/Y') }}</td>
            <td>
              {% set st = inscription.statut|upper %}
              <span class="badge {{ st == 'ACTIVE' ? 'badge-success' : (st == 'ANNULEE' ? 'badge-error' : 'badge-neutral') }}">{{ inscription.statut|capitalize }}</span>
            </td>
            <td>{{ inscription.note is not null ? inscription.note ~ '/20' : '—' }}</td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="text-center">Aucune inscription pour le moment.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="pagination-row"><span>{{ inscriptions|length }} inscription(s)</span></div>
</div>

{% endblock %}
