{% extends 'layout/_shell_etudiant.html.twig' %}
{% set active_nav = 'moyenne' %}
{% block page_title %}Ma moyenne{% endblock %}
{% block page_subtitle %}Votre performance globale{% endblock %}
{% block content %}

<div class="card"><div class="stat-card-body-primary">
  <div class="kpi-label">Votre moyenne générale</div>
  <div style="font-family:var(--font-display);font-weight:700;font-size:48px;letter-spacing:var(--tracking-heading);color:var(--color-primary-hover);margin-top:8px;">14,5<span style="font-size:20px;font-weight:500;">/20</span></div>
</div></div>

<div class="card" style="margin-top:24px;">
  <div class="card-body">
    <div class="card-title">Notes par formation</div>
    <div style="display:flex;align-items:flex-end;gap:24px;margin-top:16px;height:130px;border-bottom:1px solid var(--border);">
      <div style="display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;">
        <div style="font-size:12px;font-weight:600;">15/20</div>
        <div class="bar" style="height:75%;width:44px;max-width:none;"></div>
        <div style="font-size:11px;color:var(--text-muted);text-align:center;">Développement Web Full-Stack</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;">
        <div style="font-size:12px;font-weight:600;">14/20</div>
        <div class="bar" style="height:70%;width:44px;max-width:none;"></div>
        <div style="font-size:11px;color:var(--text-muted);text-align:center;">Management de Projet Agile</div>
      </div>
    </div>
  </div>
</div>

{% endblock %}
