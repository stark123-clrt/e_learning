{% extends 'layout/_shell_admin.html.twig' %}
{% set active_nav = 'comptes' %}
{% block page_title %}Comptes{% endblock %}
{% block page_subtitle %}Gestion des comptes utilisateurs et validation des inscriptions{% endblock %}
{% block content %}

{% for message in app.flashes('success') %}
  <div style="background:var(--success-50);color:var(--success-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('danger') %}
  <div style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Nom</th><th>Email</th><th>Rôle</th><th>Statut</th><th>Créé le</th><th>Actions</th></tr></thead>
      <tbody>
        {% for compte in comptes %}
          {% set u = compte.utilisateur %}
          {% set statut = u.statut|upper %}
          <tr>
            <td>{{ compte.nom }}</td>
            <td>{{ u.email }}</td>
            <td>
              {% if u.role|upper == 'ADMIN' %}<span class="badge badge-primary">Administrateur</span>
              {% elseif u.role|upper == 'FORMATEUR' %}<span class="badge badge-neutral">Formateur</span>
              {% else %}<span class="badge badge-outline">Étudiant</span>{% endif %}
            </td>
            <td>
              {% if statut == 'ACTIF' %}<span class="badge badge-success">Actif</span>
              {% elseif statut == 'EN_ATTENTE' %}<span class="badge badge-warning">En attente</span>
              {% else %}<span class="badge badge-neutral">{{ u.statut|capitalize }}</span>{% endif %}
            </td>
            <td>{{ u.dateCreation ? u.dateCreation|date('d/m/Y') : '—' }}</td>
            <td class="table-actions">
              {% if statut == 'EN_ATTENTE' %}
                <form action="{{ path('app_utilisateur_valider', {id: u.id}) }}" method="post" style="display:inline;">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('valider_compte_' ~ u.id) }}">
                  <button class="btn btn-primary btn-sm" type="submit">Valider</button>
                </form>
              {% endif %}
              <form action="{{ path('app_utilisateur_supprimer', {id: u.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Supprimer définitivement ce compte ?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer_compte_' ~ u.id) }}">
                <button class="btn btn-destructive btn-sm" type="submit">Supprimer</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="text-center">Aucun compte utilisateur.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="pagination-row"><span>{{ comptes|length }} compte(s)</span></div>
</div>

{% endblock %}
