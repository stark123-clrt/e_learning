{% extends 'layout/_shell_admin.html.twig' %}
{% set active_nav = 'classes' %}
{% block page_title %}Classes{% endblock %}
{% block page_subtitle %}Gérer les classes et niveaux de l'école{% endblock %}
{% block content %}

{% for message in app.flashes('success') %}
  <div style="background:var(--success-50);color:var(--success-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('danger') %}
  <div style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}

<div class="toolbar">
  <div class="toolbar-spacer"></div>
  <a class="btn btn-primary" href="{{ path('admin_classe_new') }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Créer une classe</a>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Nom</th><th>Niveau</th><th>Description</th><th>Créée le</th><th>Actions</th></tr></thead>
      <tbody>
        {% for classe in classes %}
          <tr>
            <td>{{ classe.nom }}</td>
            <td>{% if classe.niveau %}<span class="tag tag-sm" style="cursor:default;">{{ classe.niveau }}</span>{% else %}—{% endif %}</td>
            <td>{{ classe.description ?: '—' }}</td>
            <td>{{ classe.dateCreation|date('d/m/Y') }}</td>
            <td class="table-actions">
              <a class="icon-btn" href="{{ path('admin_classe_edit', {id: classe.id}) }}" aria-label="Modifier {{ classe.nom }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg></a>
              <form action="{{ path('admin_classe_delete', {id: classe.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Supprimer cette classe ?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_classe_' ~ classe.id) }}">
                <button class="icon-btn icon-btn-destructive" type="submit" aria-label="Supprimer {{ classe.nom }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="text-center">Aucune classe. Créez-en une pour commencer.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="pagination-row"><span>{{ classes|length }} classe(s)</span></div>
</div>

{% endblock %}
