{% extends 'base.html.twig' %}

{% block title %}Connexion — e-learning{% endblock %}

{% block body %}
<div class="auth-page">
  <div class="auth-card">
    <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:28px;">
      <a href="/" class="brand-mark" aria-label="Retour à l'accueil" style="text-decoration:none;">e</a>
      <div style="font-family:var(--font-display);font-weight:700;font-size:20px;">e-learning</div>
    </div>
    {% for message in app.flashes('success') %}
      <div style="background:var(--success-50);color:var(--success-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
    {% endfor %}
    {% if error %}
      <div class="field-error" style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form style="display:flex;flex-direction:column;gap:14px;" action="{{ path('app_login') }}" method="post">
      <div class="field">
        <label class="field-label" for="email">Email</label>
        <input class="input" type="email" id="email" name="email" placeholder="vous@email.fr" value="{{ last_username }}" autocomplete="username" required>
      </div>
      <div class="field">
        <label class="field-label" for="password">Mot de passe</label>
        <input class="input" type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required>
      </div>
      <div style="text-align:right;"><a href="{{ path('app_forgot_password') }}" style="font-size:13px;">Mot de passe oublié ?</a></div>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
      <button type="submit" class="btn btn-primary btn-block" style="height:44px;">Se connecter</button>
    </form>
    <div style="display:flex;align-items:center;gap:12px;margin:18px 0;color:var(--text-muted);font-size:12px;">
      <span style="flex:1;height:1px;background:var(--border);"></span>ou<span style="flex:1;height:1px;background:var(--border);"></span>
    </div>
    <a href="{{ path('connect_google') }}" class="btn btn-secondary btn-block" style="height:44px;gap:10px;">
      <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
      Se connecter avec Google
    </a>
    <div style="font-size:13px;color:var(--text-muted);text-align:center;margin-top:20px;">
      Pas encore de compte ? <a href="/inscription-compte">Créer un compte</a>
    </div>
    <div style="font-size:12px;color:var(--text-muted);text-align:center;margin-top:16px;line-height:1.6;">Plateforme accessible aux profils <strong>Administrateur</strong>, <strong>Formateur</strong> et <strong>Étudiant</strong>.</div>
  </div>
</div>
{% endblock %}
