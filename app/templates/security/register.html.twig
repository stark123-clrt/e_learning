{% extends 'base.html.twig' %}

{% block title %}Créer un compte — e-learning{% endblock %}

{% block body %}
<div class="auth-page">
  <div class="auth-card" style="max-width:460px;">
    <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:28px;">
      <a href="/" class="brand-mark" aria-label="Retour à l'accueil" style="text-decoration:none;">e</a>
      <div style="font-family:var(--font-display);font-weight:700;font-size:20px;">e-learning</div>
      <div style="font-size:13px;color:var(--text-muted);">Créer un compte étudiant</div>
    </div>
    {% if errors is defined and errors|length %}
      <div style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">
        <ul style="margin:0;padding-left:18px;">
          {% for message in errors %}<li>{{ message }}</li>{% endfor %}
        </ul>
      </div>
    {% endif %}
    <form style="display:flex;flex-direction:column;gap:14px;" action="{{ path('app_register') }}" method="post">
      <div style="display:flex;gap:14px;">
        <div class="field" style="flex:1;">
          <label class="field-label" for="nom">Nom</label>
          <input class="input" type="text" id="nom" name="nom" placeholder="Martin" value="{{ data.nom|default('') }}" autocomplete="family-name" required>
        </div>
        <div class="field" style="flex:1;">
          <label class="field-label" for="prenom">Prénom</label>
          <input class="input" type="text" id="prenom" name="prenom" placeholder="Sophie" value="{{ data.prenom|default('') }}" autocomplete="given-name" required>
        </div>
      </div>
      <div style="display:flex;gap:14px;">
        <div class="field" style="flex:2;">
          <label class="field-label" for="email">Email</label>
          <input class="input" type="email" id="email" name="email" placeholder="vous@email.fr" value="{{ data.email|default('') }}" autocomplete="username" required>
        </div>
        <div class="field" style="flex:1;">
          <label class="field-label" for="niveau">Niveau</label>
          <select class="select" id="niveau" name="niveau" required>
            <option value="" {% if not data.niveau|default('') %}selected{% endif %} disabled>—</option>
            {% for niveau in ['L1', 'L2', 'L3', 'M1', 'M2'] %}
              <option value="{{ niveau }}" {% if data.niveau|default('') == niveau %}selected{% endif %}>{{ niveau }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div style="display:flex;gap:14px;">
        <div class="field" style="flex:1;">
          <label class="field-label" for="password">Mot de passe</label>
          <input class="input" type="password" id="password" name="password" placeholder="••••••••" autocomplete="new-password" required minlength="8">
        </div>
        <div class="field" style="flex:1;">
          <label class="field-label" for="password-confirm">Confirmer</label>
          <input class="input" type="password" id="password-confirm" name="password_confirm" placeholder="••••••••" autocomplete="new-password" required minlength="8">
        </div>
      </div>
      <label style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--text-secondary);line-height:1.5;margin-top:4px;">
        <input type="checkbox" required style="margin-top:3px;">
        <span>J'accepte les <a href="#cgu">conditions d'utilisation</a> de la plateforme.</span>
      </label>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
      <button type="submit" class="btn btn-primary btn-block" style="height:44px;margin-top:4px;">Créer mon compte</button>
    </form>
    <div style="font-size:13px;color:var(--text-muted);text-align:center;margin-top:24px;">
      Déjà un compte ? <a href="/login">Se connecter</a>
    </div>
  </div>
</div>
{% endblock %}
