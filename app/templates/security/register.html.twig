{% extends 'base.html.twig' %}

{% block title %}Créer un compte — e-learning{% endblock %}

{% block body %}
<div class="auth-page">
  <div class="auth-card" style="max-width:460px;">
    <a href="/" style="font-size:13px;color:var(--text-muted);display:inline-flex;align-items:center;gap:4px;margin-bottom:12px;">← Retour à l'accueil</a>
    <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:28px;">
      <a href="/" class="brand-mark" aria-label="Retour à l'accueil" style="text-decoration:none;">e</a>
      <div style="font-family:var(--font-display);font-weight:700;font-size:20px;">e-learning</div>
      <div style="font-size:13px;color:var(--text-muted);">Créer un compte étudiant</div>
    </div>
    {% if errors is defined and errors|length %}
      <div style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">
        <ul style="margin:0;padding-left:18px;">
          {% for message in errors %}<li>{{ message }}</li>{% endfor %}
        </ul>
      </div>
    {% endif %}
    <form style="display:flex;flex-direction:column;gap:14px;" action="{{ path('app_register') }}" method="post">
      <div style="display:flex;gap:14px;">
        <div class="field" style="flex:1;">
          <label class="field-label" for="nom">Nom</label>
          <input class="input" type="text" id="nom" name="nom" placeholder="Martin" value="{{ data.nom|default('') }}" autocomplete="family-name" required>
        </div>
        <div class="field" style="flex:1;">
          <label class="field-label" for="prenom">Prénom</label>
          <input class="input" type="text" id="prenom" name="prenom" placeholder="Sophie" value="{{ data.prenom|default('') }}" autocomplete="given-name" required>
        </div>
      </div>
      <div style="display:flex;gap:14px;">
        <div class="field" style="flex:2;">
          <label class="field-label" for="email">Email</label>
          <input class="input" type="email" id="email" name="email" placeholder="vous@email.fr" value="{{ data.email|default('') }}" autocomplete="username" required>
        </div>
        <div class="field" style="flex:1;">
          <label class="field-label" for="niveau">Niveau</label>
          <select class="select" id="niveau" name="niveau" required>
            <option value="" {% if not data.niveau|default('') %}selected{% endif %} disabled>—</option>
            {% for niveau in ['L1', 'L2', 'L3', 'M1', 'M2'] %}
              <option value="{{ niveau }}" {% if data.niveau|default('') == niveau %}selected{% endif %}>{{ niveau }}</option>
            {% endfor %}
          </select>
        </div>
      </div>
      <div style="display:flex;gap:14px;">
        <div class="field" style="flex:1;">
          <label class="field-label" for="password">Mot de passe</label>
          <div style="position:relative;">
            <input class="input" type="password" id="password" name="password" placeholder="••••••••" autocomplete="new-password" required minlength="8" style="padding-right:42px;">
            <button type="button" data-toggle-password="password" aria-label="Afficher le mot de passe" aria-pressed="false" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-muted);padding:6px;display:flex;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div class="field" style="flex:1;">
          <label class="field-label" for="password-confirm">Confirmer</label>
          <div style="position:relative;">
            <input class="input" type="password" id="password-confirm" name="password_confirm" placeholder="••••••••" autocomplete="new-password" required minlength="8" style="padding-right:42px;">
            <button type="button" data-toggle-password="password-confirm" aria-label="Afficher le mot de passe" aria-pressed="false" style="position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--text-muted);padding:6px;display:flex;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
      </div>
      <label style="display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--text-secondary);line-height:1.5;margin-top:4px;">
        <input type="checkbox" required style="margin-top:3px;">
        <span>J'accepte les <a href="#cgu">conditions d'utilisation</a> de la plateforme.</span>
      </label>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
      <button type="submit" class="btn btn-primary btn-block" style="height:44px;margin-top:4px;">Créer mon compte</button>
    </form>
    <div style="display:flex;align-items:center;gap:12px;margin:18px 0;color:var(--text-muted);font-size:12px;">
      <span style="flex:1;height:1px;background:var(--border);"></span>ou<span style="flex:1;height:1px;background:var(--border);"></span>
    </div>
    <a href="{{ path('connect_google') }}" class="btn btn-secondary btn-block" style="height:44px;gap:10px;">
      <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
      S'inscrire avec Google
    </a>
    <div style="font-size:13px;color:var(--text-muted);text-align:center;margin-top:24px;">
      Déjà un compte ? <a href="/login">Se connecter</a>
    </div>
  </div>
</div>
{% endblock %}
