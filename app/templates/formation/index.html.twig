{% extends 'layout/_shell_admin.html.twig' %}
{% set active_nav = 'formations' %}
{% block page_title %}Formations{% endblock %}
{% block page_subtitle %}Catalogue complet des formations proposées{% endblock %}
{% block content %}

{% for message in app.flashes('success') %}
  <div style="background:var(--success-50);color:var(--success-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('danger') %}
  <div style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}

<div class="toolbar">
  <div class="toolbar-spacer"></div>
  <a class="btn btn-primary" href="{{ path('admin_formation_new') }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Créer une formation</a>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Titre</th><th>Catégorie</th><th>Formateur</th><th>Prix</th><th>Statut</th><th>Actions</th></tr></thead>
      <tbody>
        {% for formation in formations %}
          <tr>
            <td>{{ formation.titre }}</td>
            <td>{% if formation.categorie %}<span class="tag tag-sm" style="cursor:default;">{{ formation.categorie }}</span>{% else %}—{% endif %}</td>
            <td>{{ formation.formateur ? formation.formateur.prenom ~ ' ' ~ formation.formateur.nom : '—' }}</td>
            <td>{{ formation.prix|number_format(0, ',', ' ') }} €</td>
            <td><span class="badge {{ formation.statut|upper == 'OUVERTE' ? 'badge-success' : 'badge-neutral' }}">{{ formation.statut|capitalize }}</span></td>
            <td><div class="table-actions">
              <a class="icon-btn" href="{{ path('admin_formation_show', {id: formation.id}) }}" aria-label="Voir"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
              <a class="icon-btn" href="{{ path('admin_formation_edit', {id: formation.id}) }}" aria-label="Modifier"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg></a>
              <a class="icon-btn icon-btn-destructive" href="{{ path('admin_formation_delete', {id: formation.id}) }}" onclick="return confirm('Supprimer cette formation ?');" aria-label="Supprimer"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></a>
            </div></td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="text-center">Aucune formation. Créez-en une pour commencer.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="pagination-row"><span>{{ formations|length }} formation(s)</span></div>
</div>

{% endblock %}
