{% extends 'layout/_shell_etudiant.html.twig' %}
{% set active_nav = 'catalogue' %}
{% block page_title %}Catalogue{% endblock %}
{% block page_subtitle %}Découvrez et inscrivez-vous à nos formations{% endblock %}
{% block content %}

<div class="toolbar">
  <div class="input-icon-wrap search-wrap">
    <label class="field-label" for="catalog-search" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Rechercher une formation</label>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input class="input" type="search" id="catalog-search" placeholder="Rechercher une formation…">
  </div>
  <div style="min-width:180px;">
    <label class="field-label" for="catalog-category" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Catégorie</label>
    <select class="select" id="catalog-category">
      <option>Toutes catégories</option>
      <option>Développement</option><option>Data</option><option>Design</option><option>Réseaux</option><option>Management</option>
    </select>
  </div>
  <button class="tag" type="button" aria-pressed="false">Places disponibles</button>
</div>

<div class="formation-grid">

  <div class="card">
    <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div class="card-body">
      <div class="card-title" style="font-size:15px;">Développement Web Full-Stack</div>
      <div style="margin-top:8px;"><span class="tag tag-sm" style="cursor:default;">Développement</span></div>
      <div style="font-size:13px;color:var(--text-secondary);margin-top:10px;">12 semaines · 4 places restantes</div>
      <div style="font-size:15px;font-weight:700;margin-top:6px;">1 490 €</div>
      <div style="margin-top:12px;"><button class="btn btn-secondary btn-block" type="button" disabled>Déjà inscrit</button></div>
    </div>
  </div>

  <div class="card">
    <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div class="card-body">
      <div class="card-title" style="font-size:15px;">Data Science avec Python</div>
      <div style="margin-top:8px;"><span class="tag tag-sm" style="cursor:default;">Data</span></div>
      <div style="font-size:13px;color:var(--text-secondary);margin-top:10px;">10 semaines · 6 places restantes</div>
      <div style="font-size:15px;font-weight:700;margin-top:6px;">1 690 €</div>
      <div style="margin-top:12px;"><a class="btn btn-primary btn-block" href="/etudiant/catalogue/1">S'inscrire</a></div>
    </div>
  </div>

  <div class="card">
    <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div class="card-body">
      <div class="card-title" style="font-size:15px;">Cybersécurité Fondamentaux</div>
      <div style="margin-top:8px;"><span class="tag tag-sm" style="cursor:default;">Réseaux</span></div>
      <div style="font-size:13px;color:var(--text-secondary);margin-top:10px;">8 semaines · 0 place restante</div>
      <div style="font-size:15px;font-weight:700;margin-top:6px;">1 290 €</div>
      <div style="margin-top:12px;"><button class="btn btn-secondary btn-block" type="button" disabled>Déjà inscrit</button></div>
    </div>
  </div>

  <div class="card">
    <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div class="card-body">
      <div class="card-title" style="font-size:15px;">UX/UI Design</div>
      <div style="margin-top:8px;"><span class="tag tag-sm" style="cursor:default;">Design</span></div>
      <div style="font-size:13px;color:var(--text-secondary);margin-top:10px;">9 semaines · 7 places restantes</div>
      <div style="font-size:15px;font-weight:700;margin-top:6px;">1 390 €</div>
      <div style="margin-top:12px;"><a class="btn btn-primary btn-block" href="/etudiant/catalogue/1">S'inscrire</a></div>
    </div>
  </div>

  <div class="card">
    <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div class="card-body">
      <div class="card-title" style="font-size:15px;">Data Analyse &amp; Visualisation</div>
      <div style="margin-top:8px;"><span class="tag tag-sm" style="cursor:default;">Data</span></div>
      <div style="font-size:13px;color:var(--text-secondary);margin-top:10px;">7 semaines · 3 places restantes</div>
      <div style="font-size:15px;font-weight:700;margin-top:6px;">1 190 €</div>
      <div style="margin-top:12px;"><button class="btn btn-secondary btn-block" type="button" disabled>Déjà inscrit</button></div>
    </div>
  </div>

  <div class="card">
    <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
    <div class="card-body">
      <div class="card-title" style="font-size:15px;">Sécurité des Réseaux Avancée</div>
      <div style="margin-top:8px;"><span class="tag tag-sm" style="cursor:default;">Réseaux</span></div>
      <div style="font-size:13px;color:var(--text-secondary);margin-top:10px;">8 semaines · 0 place restante</div>
      <div style="font-size:15px;font-weight:700;margin-top:6px;">1 450 €</div>
      <div style="margin-top:12px;"><button class="btn btn-secondary btn-block" type="button" disabled>Complet</button></div>
    </div>
  </div>

</div>

{% endblock %}
