{% extends 'layout/_shell_admin.html.twig' %}
{% set active_nav = 'formateurs' %}
{% block page_title %}Formateurs{% endblock %}
{% block page_subtitle %}Gérer les comptes formateurs de la plateforme{% endblock %}
{% block content %}

{% for message in app.flashes('success') %}
  <div style="background:var(--success-50);color:var(--success-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('danger') %}
  <div style="background:var(--error-50);color:var(--error-500);padding:10px 14px;border-radius:var(--radius-sm);font-size:13px;margin-bottom:14px;">{{ message }}</div>
{% endfor %}

<div class="toolbar">
  <div class="input-icon-wrap search-wrap">
    <label class="field-label" for="trainer-search" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Rechercher un formateur</label>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input class="input" type="search" id="trainer-search" placeholder="Rechercher un formateur…">
  </div>
  <div class="toolbar-spacer"></div>
  <a class="btn btn-primary" href="{{ path('admin_formateur_new') }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Ajouter un formateur</a>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>Nom</th><th>Prénom</th><th>Email</th><th>Spécialité</th><th>Statut</th><th>Formations</th><th>Actions</th></tr>
      </thead>
      <tbody>
        {% for formateur in formateurs %}
          <tr>
            <td>{{ formateur.nom }}</td>
            <td>{{ formateur.prenom }}</td>
            <td>{{ formateur.email }}</td>
            <td>{{ formateur.specialite }}</td>
            <td><span class="badge {{ formateur.statut == 'ACTIF' ? 'badge-success' : 'badge-neutral' }}">{{ formateur.statut|capitalize }}</span></td>
            <td>{{ formationCounts[formateur.id] ?? 0 }}</td>
            <td>
              <div class="table-actions">
                <a class="icon-btn" href="{{ path('admin_formateur_show', {'id': formateur.id}) }}" aria-label="Voir {{ formateur.prenom }} {{ formateur.nom }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
                <a class="icon-btn" href="{{ path('admin_formateur_edit', {'id': formateur.id}) }}" aria-label="Modifier {{ formateur.prenom }} {{ formateur.nom }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg></a>
                <form action="{{ path('admin_formateur_delete', {'id': formateur.id}) }}" method="post" style="display:inline;" onsubmit="return confirm('Supprimer ce formateur ?');">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_formateur') }}">
                  <button class="icon-btn icon-btn-destructive" type="submit" aria-label="Supprimer {{ formateur.prenom }} {{ formateur.nom }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
                </form>
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="7" class="text-center">Aucun formateur trouvé.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="pagination-row"><span>{{ formateurs|length }} formateur(s)</span></div>
</div>

{% endblock %}
