{% extends 'layout/_shell_admin.html.twig' %}
{% set active_nav = 'formateurs' %}
{% block page_title %}{{ formAction }} un formateur{% endblock %}
{% block page_subtitle %}Gestion des informations du formateur{% endblock %}
{% block content %}

{% if errors is not empty %}
  <div class="alert alert-danger">
    <ul>
      {% for error in errors %}
        <li>{{ error }}</li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

<form action="{{ path(formRoute, formateur is not null ? {'id': formateur.id} : {}) }}" method="post" style="display:flex;flex-direction:column;gap:16px;max-width:540px;">
  <div class="field">
    <label class="field-label" for="nom">Nom</label>
    <input class="input" type="text" id="nom" name="nom" value="{{ formateurData.nom }}" required>
  </div>

  <div class="field">
    <label class="field-label" for="prenom">Prénom</label>
    <input class="input" type="text" id="prenom" name="prenom" value="{{ formateurData.prenom }}" required>
  </div>

  <div class="field">
    <label class="field-label" for="email">Email</label>
    <input class="input" type="email" id="email" name="email" value="{{ formateurData.email }}" required>
  </div>

  <div class="field">
    <label class="field-label" for="specialite">Spécialité</label>
    <input class="input" type="text" id="specialite" name="specialite" value="{{ formateurData.specialite }}" required>
  </div>

  <div class="field">
    <label class="field-label" for="statut">Statut</label>
    <select class="select" id="statut" name="statut" required>
      <option value="ACTIF" {{ formateurData.statut == 'ACTIF' ? 'selected' : '' }}>Actif</option>
      <option value="INACTIF" {{ formateurData.statut == 'INACTIF' ? 'selected' : '' }}>Inactif</option>
    </select>
  </div>

  <input type="hidden" name="_csrf_token" value="{{ csrf_token('formateur_form') }}">
  <button class="btn btn-primary" type="submit">{{ formAction }}</button>
  <a class="btn btn-secondary" href="{{ path('admin_formateurs') }}">Annuler</a>
</form>

{% endblock %}
