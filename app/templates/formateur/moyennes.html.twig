{% extends 'layout/_shell_formateur.html.twig' %}
{% set active_nav = 'moyennes' %}
{% block page_title %}Moyennes{% endblock %}
{% block page_subtitle %}Moyennes par formation{% endblock %}
{% block content %}

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Formation</th><th>Notes saisies</th><th>Moyenne</th></tr></thead>
      <tbody>
        {% for ligne in lignes %}
          <tr>
            <td>{{ ligne.titre }}</td>
            <td>{{ ligne.nbNotes }}</td>
            <td>{% if ligne.moyenne %}<strong>{{ ligne.moyenne }}/20</strong>{% else %}<span style="color:var(--text-muted);">—</span>{% endif %}</td>
          </tr>
        {% else %}
          <tr><td colspan="3" class="text-center">Aucune formation ne vous est attribuée.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% endblock %}
