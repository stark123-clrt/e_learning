{% extends 'layout/_shell_formateur.html.twig' %}
{% set active_nav = 'formations' %}
{% block page_title %}Mes formations{% endblock %}
{% block page_subtitle %}Formations dont vous êtes responsable{% endblock %}
{% block content %}

<div class="formation-grid">
  {% for item in formations %}
    <div class="card">
      <div class="card-media" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
      <div class="card-body">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
          <div class="card-title" style="font-size:15px;">{{ item.formation.titre }}</div>
          <span class="badge {{ item.formation.statut|upper == 'OUVERTE' ? 'badge-success' : 'badge-neutral' }}">{{ item.formation.statut|capitalize }}</span>
        </div>
        <div style="font-size:13px;color:var(--text-secondary);margin-top:8px;">{{ item.formation.duree }} semaines · {{ item.nbInscrits }}/{{ item.formation.capaciteMax }} inscrits</div>
        <div style="margin-top:12px;">
          <a class="btn btn-secondary btn-sm" href="{{ path('formateur_etudiants', {id: item.formation.id}) }}">Voir les étudiants</a>
        </div>
      </div>
    </div>
  {% else %}
    <div style="font-size:14px;color:var(--text-muted);">Aucune formation ne vous est attribuée pour le moment.</div>
  {% endfor %}
</div>

{% endblock %}
