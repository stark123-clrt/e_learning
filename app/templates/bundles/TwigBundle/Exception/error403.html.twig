{% extends 'base.html.twig' %}

{% block title %}Accès refusé — e-learning{% endblock %}

{% block body %}
<div class="auth-page">
  <div class="auth-card" style="max-width:440px;text-align:center;">
    <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:20px;">
      <a href="/" class="brand-mark" aria-label="Retour à l'accueil" style="text-decoration:none;">e</a>
      <div style="font-family:var(--font-display);font-weight:700;font-size:20px;">e-learning</div>
    </div>
    <div style="width:72px;height:72px;border-radius:var(--radius-full);background:var(--error-50);color:var(--error-500);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    </div>
    <div style="font-family:var(--font-display);font-weight:700;font-size:44px;letter-spacing:var(--tracking-heading);color:var(--text-primary);">403</div>
    <h1 style="font-size:var(--text-subhead);margin-top:8px;">Accès refusé</h1>
    <p style="font-size:14px;color:var(--text-secondary);line-height:1.6;margin-top:10px;">
      Vous n'avez pas les autorisations nécessaires pour consulter cette page. Si vous pensez qu'il s'agit d'une erreur, contactez un administrateur.
    </p>
    <div style="display:flex;gap:10px;justify-content:center;margin-top:26px;">
      <a href="/" class="btn btn-secondary">Retour à l'accueil</a>
      <a href="/admin/dashboard" class="btn btn-primary">Retour au tableau de bord</a>
    </div>
  </div>
</div>
{% endblock %}
